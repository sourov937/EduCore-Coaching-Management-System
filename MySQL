-- ============================================
-- EduCore Coaching Management System
-- Database Schema
-- ============================================

CREATE DATABASE IF NOT EXISTS educore;
USE educore;

-- ============================================
-- 1. DIRECTOR
-- ============================================
CREATE TABLE IF NOT EXISTS DIRECTOR (
    Director_ID INT AUTO_INCREMENT PRIMARY KEY,
    Name VARCHAR(100) NOT NULL,
    Email VARCHAR(100) UNIQUE NOT NULL,
    Phone VARCHAR(20),
    Password VARCHAR(255) NOT NULL
);

-- ============================================
-- 2. GUARDIAN
-- ============================================
CREATE TABLE IF NOT EXISTS GUARDIAN (
    Guardian_ID INT AUTO_INCREMENT PRIMARY KEY,
    Name VARCHAR(100) NOT NULL,
    Phone VARCHAR(20),
    Email VARCHAR(100) UNIQUE NOT NULL,
    Password VARCHAR(255) NOT NULL,
    Address VARCHAR(255)
);

-- ============================================
-- 3. TEACHER
-- ============================================
CREATE TABLE IF NOT EXISTS TEACHER (
    Teacher_ID INT AUTO_INCREMENT PRIMARY KEY,
    Name VARCHAR(100) NOT NULL,
    Subject VARCHAR(100),
    Phone VARCHAR(20),
    Email VARCHAR(100) UNIQUE NOT NULL,
    Password VARCHAR(255) NOT NULL
);

-- ============================================
-- 4. BATCH
-- ============================================
CREATE TABLE IF NOT EXISTS BATCH (
    Batch_ID INT AUTO_INCREMENT PRIMARY KEY,
    Batch_Name VARCHAR(100) NOT NULL,
    Subject VARCHAR(100),
    Schedule VARCHAR(255),
    Teacher_ID INT,
    FOREIGN KEY (Teacher_ID) REFERENCES TEACHER(Teacher_ID) ON DELETE SET NULL
);

-- ============================================
-- 5. STUDENT
-- ============================================
CREATE TABLE IF NOT EXISTS STUDENT (
    Student_ID INT AUTO_INCREMENT PRIMARY KEY,
    Name VARCHAR(100) NOT NULL,
    DOB DATE,
    Gender VARCHAR(10),
    Phone VARCHAR(20),
    Email VARCHAR(100) UNIQUE NOT NULL,
    Password VARCHAR(255) NOT NULL,
    Batch_ID INT,
    Guardian_ID INT,
    FOREIGN KEY (Batch_ID) REFERENCES BATCH(Batch_ID) ON DELETE SET NULL,
    FOREIGN KEY (Guardian_ID) REFERENCES GUARDIAN(Guardian_ID) ON DELETE SET NULL
);

-- ============================================
-- 6. ATTENDANCE
-- ============================================
CREATE TABLE IF NOT EXISTS ATTENDANCE (
    Attendance_ID INT AUTO_INCREMENT PRIMARY KEY,
    Student_ID INT NOT NULL,
    Batch_ID INT NOT NULL,
    Date DATE NOT NULL,
    Status ENUM('Present', 'Absent', 'Late') NOT NULL DEFAULT 'Present',
    FOREIGN KEY (Student_ID) REFERENCES STUDENT(Student_ID) ON DELETE CASCADE,
    FOREIGN KEY (Batch_ID) REFERENCES BATCH(Batch_ID) ON DELETE CASCADE
);

-- ============================================
-- 7. EXAM
-- ============================================
CREATE TABLE IF NOT EXISTS EXAM (
    Exam_ID INT AUTO_INCREMENT PRIMARY KEY,
    Exam_Name VARCHAR(150) NOT NULL,
    Subject VARCHAR(100),
    Exam_Date DATE,
    Total_Marks DOUBLE DEFAULT 100,
    Batch_ID INT,
    FOREIGN KEY (Batch_ID) REFERENCES BATCH(Batch_ID) ON DELETE SET NULL
);

-- ============================================
-- 8. RESULT
-- ============================================
CREATE TABLE IF NOT EXISTS RESULT (
    Result_ID INT AUTO_INCREMENT PRIMARY KEY,
    Student_ID INT NOT NULL,
    Exam_ID INT NOT NULL,
    Marks_Obtained DOUBLE,
    Grade VARCHAR(5),
    Remarks VARCHAR(255),
    FOREIGN KEY (Student_ID) REFERENCES STUDENT(Student_ID) ON DELETE CASCADE,
    FOREIGN KEY (Exam_ID) REFERENCES EXAM(Exam_ID) ON DELETE CASCADE
);

-- ============================================
-- 9. FEE
-- ============================================
CREATE TABLE IF NOT EXISTS FEE (
    Fee_ID INT AUTO_INCREMENT PRIMARY KEY,
    Student_ID INT NOT NULL,
    Amount DOUBLE NOT NULL,
    Due_Date DATE,
    Payment_Date DATE,
    Status ENUM('Paid', 'Unpaid', 'Partial') NOT NULL DEFAULT 'Unpaid',
    FOREIGN KEY (Student_ID) REFERENCES STUDENT(Student_ID) ON DELETE CASCADE
);

-- ============================================
-- 10. NOTICE
-- ============================================
CREATE TABLE IF NOT EXISTS NOTICE (
    Notice_ID INT AUTO_INCREMENT PRIMARY KEY,
    Title VARCHAR(200) NOT NULL,
    Content TEXT,
    Date_Posted DATE NOT NULL,
    Target_Role ENUM('All', 'Teacher', 'Student', 'Guardian') DEFAULT 'All'
);

-- ============================================
-- 11. ASSIGNMENT
-- ============================================
CREATE TABLE IF NOT EXISTS ASSIGNMENT (
    Assignment_ID INT AUTO_INCREMENT PRIMARY KEY,
    Title VARCHAR(200) NOT NULL,
    Description TEXT,
    Due_Date DATE,
    Batch_ID INT NOT NULL,
    Teacher_ID INT,
    FOREIGN KEY (Batch_ID) REFERENCES BATCH(Batch_ID) ON DELETE CASCADE,
    FOREIGN KEY (Teacher_ID) REFERENCES TEACHER(Teacher_ID) ON DELETE SET NULL
);

-- ============================================
-- 12. TEACHER_REVIEW
-- ============================================
CREATE TABLE IF NOT EXISTS TEACHER_REVIEW (
    Review_ID INT AUTO_INCREMENT PRIMARY KEY,
    Student_ID INT NOT NULL,
    Teacher_ID INT NOT NULL,
    Rating INT CHECK (Rating >= 1 AND Rating <= 5),
    Comment TEXT,
    Date_Submitted DATE NOT NULL,
    FOREIGN KEY (Student_ID) REFERENCES STUDENT(Student_ID) ON DELETE CASCADE,
    FOREIGN KEY (Teacher_ID) REFERENCES TEACHER(Teacher_ID) ON DELETE CASCADE
);
